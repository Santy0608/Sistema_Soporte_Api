@model LoginVm
@{ ViewData["Title"] = "Iniciar sesión"; }

<div class="row justify-content-center">
    <div class="col-md-5">
        <h1 class="h3 mb-3">Iniciar sesión</h1>

        <form method="post" asp-action="Ingresar">
            @* Errores generales: aquí aparece "Correo o contraseña incorrectos." *@
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <input type="hidden" asp-for="ReturnUrl" />

            <div class="mb-3">
                <label asp-for="Correo" class="form-label"></label>
                <input asp-for="Correo" class="form-control" autofocus />
                <span asp-validation-for="Correo" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label">Contraseña</label>
                <input asp-for="Password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Entrar</button>
        </form>
    </div>
</div>
