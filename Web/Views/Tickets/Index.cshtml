@model ListaTicketsVm
@{
    ViewData["Title"] = "Tickets";

    //  Este valor viaja por ViewData hacia las vistas parciales que invocamos más abajo.
    // _FilaTicket lo lee para decidir si pinta la columna Cliente. ViewData es un diccionario "suelto"
    // (sin tipo): cómodo para banderas pequeñas, pero para datos de verdad usamos el modelo (ListaTicketsVm).
    ViewData["MostrarCliente"] = true;

    var estados = new[] { "Abierto", "EnProceso", "Resuelto", "Cerrado" };
}

<h1 class="h3 mb-3">Tickets</h1>

<div class="mb-3 d-flex gap-2">
    <a asp-action="Crear" class="btn btn-primary">Nuevo ticket</a>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Exportar" asp-route-estado="@Model.Estado" asp-route-q="@Model.Q" class="btn btn-outline-secondary">Exportar CSV</a>
    }
</div>

@* Formulario GET: los filtros viajan en la URL, así se pueden copiar, compartir y paginar. *@
<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-md-3">
        <select name="estado" class="form-select">
            <option value="">Todos los estados</option>
            @foreach (var e in estados)
            {
                <option value="@e" selected="@(Model.Estado == e)">@e</option>
            }
        </select>
    </div>
    <div class="col-md-6">
        <input type="text" name="q" value="@Model.Q" class="form-control" placeholder="Buscar en título o descripción" />
    </div>
    <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Filtrar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
    </div>
</form>

<p class="text-muted">@Model.Total ticket(s) encontrado(s)</p>

@if (Model.Items.Count == 0)
{
    <div class="alert alert-info">No hay tickets que coincidan con el filtro.</div>
}
else
{
    <table class="table table-striped table-hover bg-white tabla-tickets">
        <thead>
            <tr>
                <th>Código</th>
                <th>Título</th>
                <th>Cliente</th>
                <th>Prioridad</th>
                <th>Estado</th>
                <th>Creado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ticket in Model.Items)
            {
                @* Una vista parcial por fila: la fila vive en su propio archivo y se puede reutilizar. *@
                <partial name="_FilaTicket" model="ticket" />
            }
        </tbody>
    </table>
}

<partial name="_Paginador" model="Model" />
