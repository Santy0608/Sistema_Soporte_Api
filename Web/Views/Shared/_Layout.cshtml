<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* ViewData["Title"] lo escribe cada vista; el layout lo pone en la pestaña del navegador. *@
    <title>@ViewData["Title"] - Sistema de Soporte</title>

    @* Bootstrap desde CDN para no cargar la carpeta lib de la plantilla.
       Es la única "librería" del frontend: hoy no vamos a diseñar, vamos a conectar. *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Tickets" asp-action="Index">Sistema de Soporte</a>

            <ul class="navbar-nav me-auto">
                <li class="nav-item"><a class="nav-link" asp-controller="Tickets" asp-action="Index">Tickets</a></li>

                @* Esconder un botón NO es seguridad: cualquiera puede escribir la URL. Esto es solo para no
                   confundir al usuario. La protección real está en [Authorize] y en el API. *@
                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Tickets" asp-action="Exportar">Exportar CSV</a></li>
                }
            </ul>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <span class="navbar-text me-3">@User.Identity.Name (@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value)</span>
                <form method="post" asp-controller="Cuenta" asp-action="Salir" class="d-inline">
                    <button type="submit" class="btn btn-sm btn-outline-light">Salir</button>
                </form>
            }
        </div>
    </nav>

    <main class="container">
        @if (TempData["Exito"] is string exito) { <div class="alert alert-success">@exito</div> }
        @if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }

        @* Aquí se inserta el contenido de cada vista. *@
        @RenderBody()
    </main>

    <footer class="container text-muted small py-4">
        Curso SC-701 · Esta página consume el API por HTTP
    </footer>
</body>
</html>
