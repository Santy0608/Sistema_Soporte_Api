@model EtiquetaCrearVm

@{
    ViewData["Title"] = "Crear Etiqueta";
}

<h2>Crear Etiqueta</h2>

@* Aquí se muestran los errores agregados con ModelState.AddModelError(string.Empty, ...) desde el Controller *@
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Color" class="form-label"></label>
        <input asp-for="Color" class="form-control" placeholder="#ff0000 o blue" />
        <span asp-validation-for="Color" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}